const log = require('logToConsole');
const injectScript = require('injectScript');
const createArgumentsQueue = require('createArgumentsQueue');
const copyFromDataLayer = require('copyFromDataLayer');
const sha256 = require('sha256');
const getType = require('getType');
const makeNumber = require('makeNumber');
const makeString = require('makeString');
const makeInteger = require('makeInteger');
const Math = require('Math');
const Object = require('Object');

const SDK_URL = 'https://bzrcdn.openai.com/sdk/oaiq.min.js';
// Character sets. The web sandbox supports neither regex literals nor a regex API.
const DIGITS = '0123456789';
const LOWER = 'abcdefghijklmnopqrstuvwxyz';
const UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
const HEX = DIGITS + 'abcdef';
const ALNUM = DIGITS + LOWER + UPPER;
const NAME_CHARS = ALNUM + '_-';
// Same set as the JavaScript \\s class used by the pixel SDK.
const WHITESPACE = ' \t\n\r\f\v\u00a0\u1680\u2000\u2001\u2002\u2003\u2004\u2005\u2006\u2007\u2008\u2009\u200a\u2028\u2029\u202f\u205f\u3000\ufeff';
const ASCII_PUNCT = '!"#$%&\'()*+,-./:;<=>?@[\\]^_`{|}~';
const EMAIL_ATOM_CHARS = ALNUM + '_!#$%&\'*+/=?^`{|}~-';
const DOMAIN_LABEL_CHARS = DIGITS + LOWER + '-';
// Limits applied by the pixel SDK before hashing.
const MAX_IDENTIFIER_LENGTH = 1024;
const MAX_EMAIL_LENGTH = 254;

// Standard event name -> event data shape.
const STANDARD_EVENTS = {
  page_viewed: 'contents',
  contents_viewed: 'contents',
  items_added: 'contents',
  checkout_started: 'contents',
  order_created: 'contents',
  lead_created: 'customer_action',
  registration_completed: 'customer_action',
  appointment_scheduled: 'customer_action',
  subscription_created: 'plan_enrollment',
  trial_started: 'plan_enrollment',
  custom: 'custom'
};

// GA4 / GTM dataLayer event name -> OpenAI standard event name.
const DATALAYER_EVENT_MAP = {
  'gtm.js': 'page_viewed',
  'gtm.init': 'page_viewed',
  'gtm.init_consent': 'page_viewed',
  'gtm.dom': 'page_viewed',
  'gtm.load': 'page_viewed',
  'page_view': 'page_viewed',
  'view_item': 'contents_viewed',
  'view_item_list': 'contents_viewed',
  'add_to_cart': 'items_added',
  'begin_checkout': 'checkout_started',
  'purchase': 'order_created',
  'generate_lead': 'lead_created',
  'sign_up': 'registration_completed'
};

// ISO 4217 minor unit exponents that differ from the default of 2.
const MINOR_UNIT_EXPONENTS = {
  BIF: 0, CLP: 0, DJF: 0, GNF: 0, ISK: 0, JPY: 0, KMF: 0, KRW: 0, PYG: 0,
  RWF: 0, UGX: 0, UYI: 0, VND: 0, VUV: 0, XAF: 0, XOF: 0, XPF: 0,
  BHD: 3, IQD: 3, JOD: 3, KWD: 3, LYD: 3, OMR: 3, TND: 3,
  CLF: 4, UYW: 4
};

function isSet(value) {
  return value !== undefined && value !== null && value !== '';
}

function allCharsIn(text, set) {
  for (let i = 0; i < text.length; i++) {
    if (set.indexOf(text.charAt(i)) === -1) return false;
  }
  return true;
}

function removeChars(text, set) {
  let out = '';
  for (let i = 0; i < text.length; i++) {
    const c = text.charAt(i);
    if (set.indexOf(c) === -1) out += c;
  }
  return out;
}

function replaceCharsNotIn(text, set, replacement) {
  let out = '';
  for (let i = 0; i < text.length; i++) {
    const c = text.charAt(i);
    out += set.indexOf(c) === -1 ? replacement : c;
  }
  return out;
}

function trimChars(text, set) {
  let start = 0;
  let end = text.length;
  while (start < end && set.indexOf(text.charAt(start)) !== -1) start++;
  while (end > start && set.indexOf(text.charAt(end - 1)) !== -1) end--;
  return text.substring(start, end);
}

function removeLeadingZeroes(text) {
  let i = 0;
  while (i < text.length && text.charAt(i) === '0') i++;
  return text.substring(i);
}

function isHex64(text) {
  return text.length === 64 && allCharsIn(text, HEX);
}

function isValidCustomName(name) {
  return name.length >= 1 && name.length <= 64 &&
    allCharsIn(name, NAME_CHARS) &&
    ALNUM.indexOf(name.charAt(0)) !== -1 &&
    ALNUM.indexOf(name.charAt(name.length - 1)) !== -1;
}

function pick(manual, fromDataLayer) {
  return isSet(manual) ? manual : fromDataLayer;
}

function trimString(value) {
  return makeString(value).trim();
}

function parsePixelIds(raw) {
  const ids = [];
  makeString(raw || '').split(',').forEach(function (part) {
    const id = part.trim();
    if (id && ids.indexOf(id) === -1) ids.push(id);
  });
  return ids;
}

function sanitizeCustomName(raw) {
  let name = replaceCharsNotIn(makeString(raw).toLowerCase(), DIGITS + LOWER + '_-', '_');
  name = trimChars(name, '_-');
  if (name.length > 64) name = trimChars(name.substring(0, 64), '_-');
  if (!name || STANDARD_EVENTS[name]) return '';
  return name;
}

// Returns { name, customName } or a string describing why nothing can be sent.
function resolveEvent() {
  if (data.eventNameMethod === 'override') {
    if (data.eventType !== 'custom') {
      return { name: data.standardEvent, customName: '' };
    }
    const customName = trimString(data.customEventName);
    if (!isValidCustomName(customName)) {
      return 'Invalid custom event name "' + customName + '": use 1 to 64 letters, numbers, underscores or dashes, starting and ending with a letter or a number.';
    }
    if (STANDARD_EVENTS[customName]) {
      return 'Custom event name "' + customName + '" matches a standard event name. Select the standard event instead.';
    }
    return { name: 'custom', customName: customName };
  }

  const dataLayerEvent = trimString(copyFromDataLayer('event') || '');
  if (!dataLayerEvent) {
    return 'No event name found in the dataLayer.';
  }
  if (DATALAYER_EVENT_MAP[dataLayerEvent]) {
    return { name: DATALAYER_EVENT_MAP[dataLayerEvent], customName: '' };
  }
  if (STANDARD_EVENTS[dataLayerEvent] && dataLayerEvent !== 'custom') {
    return { name: dataLayerEvent, customName: '' };
  }
  const customName = sanitizeCustomName(dataLayerEvent);
  if (!customName) {
    return 'dataLayer event "' + dataLayerEvent + '" cannot be converted to a custom event name.';
  }
  return { name: 'custom', customName: customName };
}

function normalizeCurrency(value) {
  if (!isSet(value)) return '';
  const currency = trimString(value).toUpperCase();
  return currency.length === 3 ? currency : '';
}

function toMinorUnits(value, currency) {
  if (!isSet(value)) return undefined;
  const number = makeNumber(value);
  if (getType(number) !== 'number' || number !== number) return undefined;
  const exponent = MINOR_UNIT_EXPONENTS.hasOwnProperty(currency) ? MINOR_UNIT_EXPONENTS[currency] : 2;
  return Math.round(number * Math.pow(10, exponent));
}

function toInteger(value) {
  if (!isSet(value)) return undefined;
  const number = makeInteger(value);
  if (getType(number) !== 'number' || number !== number) return undefined;
  return number;
}

function keyOrDefault(value, fallback) {
  return isSet(value) ? trimString(value) : fallback;
}

// Item keys configured on the tag, defaulting to the GA4 items schema.
function getItemKeys() {
  return {
    id: keyOrDefault(data.itemIdKey, 'item_id'),
    name: keyOrDefault(data.itemNameKey, 'item_name'),
    quantity: keyOrDefault(data.itemQuantityKey, 'quantity'),
    price: keyOrDefault(data.itemPriceKey, 'price'),
    contentType: keyOrDefault(data.itemContentTypeKey, ''),
    defaultContentType: keyOrDefault(data.itemContentType, '')
  };
}

// Reads a dotted path such as "product.sku" in an object.
function readPath(object, path) {
  if (!path) return undefined;
  let current = object;
  const parts = path.split('.');
  for (let i = 0; i < parts.length; i++) {
    if (getType(current) !== 'object' && getType(current) !== 'array') return undefined;
    current = current[parts[i]];
  }
  return current;
}

function contentFromMappedItem(item, currency, keys) {
  const content = {};
  const id = readPath(item, keys.id);
  if (isSet(id)) content.id = makeString(id);
  const name = readPath(item, keys.name);
  if (isSet(name)) content.name = makeString(name);
  const contentType = readPath(item, keys.contentType);
  if (isSet(contentType)) {
    content.content_type = makeString(contentType);
  } else if (keys.defaultContentType) {
    content.content_type = keys.defaultContentType;
  }
  const quantity = toInteger(readPath(item, keys.quantity));
  if (quantity !== undefined) content.quantity = quantity;
  if (currency) {
    const amount = toMinorUnits(readPath(item, keys.price), currency);
    if (amount !== undefined) {
      content.amount = amount;
      content.currency = currency;
    }
  }
  return content;
}

function contentFromOpenAiContent(item) {
  const content = {};
  if (isSet(item.id)) content.id = makeString(item.id);
  if (isSet(item.name)) content.name = makeString(item.name);
  if (isSet(item.content_type)) content.content_type = makeString(item.content_type);
  const quantity = toInteger(item.quantity);
  if (quantity !== undefined) content.quantity = quantity;
  const amount = toInteger(item.amount);
  const currency = normalizeCurrency(item.currency);
  if (amount !== undefined) content.amount = amount;
  if (currency) content.currency = currency;
  return content;
}

function normalizeContents(items, currency) {
  if (getType(items) !== 'array') return undefined;
  const keys = getItemKeys();
  const contents = [];
  items.forEach(function (item) {
    if (getType(item) !== 'object') return;
    const isMappedItem = readPath(item, keys.id) !== undefined ||
      readPath(item, keys.name) !== undefined ||
      readPath(item, keys.price) !== undefined;
    contents.push(isMappedItem ? contentFromMappedItem(item, currency, keys) : contentFromOpenAiContent(item));
  });
  return contents.length ? contents : undefined;
}

function buildEventData(dataType) {
  const eventData = { type: dataType };
  const ecommerce = data.readEcommerce ? copyFromDataLayer('ecommerce') : undefined;
  const hasEcommerce = getType(ecommerce) === 'object';

  const currency = normalizeCurrency(pick(data.currency, hasEcommerce ? ecommerce.currency : undefined));
  const amount = toMinorUnits(pick(data.amount, hasEcommerce ? ecommerce.value : undefined), currency);

  if (amount !== undefined && currency) {
    eventData.amount = amount;
    eventData.currency = currency;
  } else if (amount !== undefined) {
    log('OpenAI Measurement Pixel: amount ignored because no valid currency is available.');
  } else if (currency) {
    eventData.currency = currency;
  }

  if ((dataType === 'plan_enrollment' || dataType === 'custom') && isSet(data.planId)) {
    eventData.plan_id = trimString(data.planId);
  }

  if (dataType !== 'customer_action') {
    let contents;
    if (isSet(data.contents)) {
      contents = normalizeContents(data.contents, currency);
    } else if (hasEcommerce) {
      contents = normalizeContents(ecommerce.items, currency);
    }
    if (contents) eventData.contents = contents;
  }

  return eventData;
}

// The normalizers below reproduce the pixel SDK (oaiq-web 0.1.41) so that a value
// hashed by the tag gives the same digest as the same value hashed by the SDK.
// Each returns '' when the SDK would reject the value.

// Mirrors the SDK email pattern: dot-separated atoms, an @, and at least two
// domain labels made of letters, digits and inner hyphens.
function isValidEmail(email) {
  const at = email.indexOf('@');
  if (at < 1 || email.indexOf('@', at + 1) !== -1) return false;
  const atoms = email.substring(0, at).split('.');
  for (let i = 0; i < atoms.length; i++) {
    if (!atoms[i].length || !allCharsIn(atoms[i], EMAIL_ATOM_CHARS)) return false;
  }
  const labels = email.substring(at + 1).split('.');
  if (labels.length < 2) return false;
  for (let i = 0; i < labels.length; i++) {
    const label = labels[i];
    if (!label.length || !allCharsIn(label, DOMAIN_LABEL_CHARS)) return false;
    if (label.charAt(0) === '-' || label.charAt(label.length - 1) === '-') return false;
  }
  return true;
}

function normalizeEmail(value) {
  const email = trimString(value).toLowerCase();
  return email.length <= MAX_EMAIL_LENGTH && isValidEmail(email) ? email : '';
}

function normalizePhone(value) {
  const cleaned = removeChars(trimString(value), WHITESPACE + '().-');
  const hasPlus = cleaned.charAt(0) === '+';
  const digits = hasPlus ? cleaned.substring(1) : cleaned;
  if (!digits || !allCharsIn(digits, DIGITS)) return '';
  if (hasPlus && digits.charAt(0) === '0') return '';
  const international = hasPlus || cleaned.substring(0, 2) === '00';
  const national = removeLeadingZeroes(digits);
  // An international number starting with 1 must be a full 11-digit NANP number.
  if (international && national.charAt(0) === '1' && national.length !== 11) return '';
  if (national.length < 8 || national.length > 15) return '';
  return national;
}

function normalizeName(value) {
  const raw = trimString(value);
  if (raw.length > MAX_IDENTIFIER_LENGTH) return '';
  const name = removeChars(raw, WHITESPACE + ASCII_PUNCT).toLowerCase();
  return name && !allCharsIn(name, DIGITS) ? name : '';
}

function normalizeExternalId(value) {
  const id = trimString(value);
  return id.length <= MAX_IDENTIFIER_LENGTH ? id : '';
}

// Builds the user object and passes it to `callback` once every hash is computed.
function buildUserData(callback) {
  const dataLayerUser = data.readUserData ? copyFromDataLayer('user_data') : undefined;
  const dataLayerUserId = data.readUserData ? copyFromDataLayer('user_id') : undefined;
  const hasUser = getType(dataLayerUser) === 'object';
  let address = hasUser ? dataLayerUser.address : undefined;
  if (getType(address) === 'array') address = address[0];
  const hasAddress = getType(address) === 'object';

  // Reads the first set key, looking in the GA4 address object first and then
  // at the root of user_data, so both nested and flattened shapes work.
  function readUser(keys) {
    for (let i = 0; i < keys.length; i++) {
      if (hasAddress && isSet(address[keys[i]])) return address[keys[i]];
      if (hasUser && isSet(dataLayerUser[keys[i]])) return dataLayerUser[keys[i]];
    }
    return undefined;
  }

  const hashedFields = [
    {
      key: 'email_sha256',
      manual: data.email,
      hashed: readUser(['sha256_email_address', 'sha256_email']),
      raw: readUser(['email_address', 'email']),
      normalize: normalizeEmail
    },
    {
      key: 'phone_number_sha256',
      manual: data.phone,
      hashed: readUser(['sha256_phone_number', 'sha256_phone']),
      raw: readUser(['phone_number', 'phone']),
      normalize: normalizePhone
    },
    {
      key: 'external_id_sha256',
      manual: data.externalId,
      hashed: readUser(['sha256_external_id', 'sha256_customer_id', 'sha256_user_id']),
      raw: pick(readUser(['external_id', 'customer_id', 'user_id']), dataLayerUserId),
      normalize: normalizeExternalId
    },
    {
      key: 'first_name_sha256',
      manual: data.firstName,
      hashed: readUser(['sha256_first_name']),
      raw: readUser(['first_name']),
      normalize: normalizeName
    },
    {
      key: 'last_name_sha256',
      manual: data.lastName,
      hashed: readUser(['sha256_last_name']),
      raw: readUser(['last_name']),
      normalize: normalizeName
    }
  ];

  const plainFields = [
    { key: 'country', manual: data.country, raw: readUser(['country']), upper: true, max: 2 },
    { key: 'city', manual: data.city, raw: readUser(['city']), max: 128 },
    { key: 'region', manual: data.region, raw: readUser(['region']), max: 128 },
    { key: 'postal_code', manual: data.postalCode, raw: readUser(['postal_code', 'zip', 'zip_code', 'postcode']), max: 32 }
  ];

  const user = {};

  plainFields.forEach(function (field) {
    const value = pick(field.manual, field.raw);
    if (!isSet(value)) return;
    let text = trimString(value);
    if (field.upper) text = text.toUpperCase();
    if (!text || text.length > field.max) return;
    user[field.key] = text;
  });

  let pending = 0;
  let finished = false;

  function done() {
    pending--;
    if (pending === 0 && !finished) {
      finished = true;
      callback(user);
    }
  }

  hashedFields.forEach(function (field) {
    let toHash;
    if (isSet(field.manual) && makeString(field.manual).length > MAX_IDENTIFIER_LENGTH) {
      log('OpenAI Measurement Pixel: ' + field.key + ' skipped, value longer than ' + MAX_IDENTIFIER_LENGTH + ' characters.');
      return;
    }
    if (isSet(field.manual)) {
      const manual = trimString(field.manual);
      if (isHex64(manual.toLowerCase())) {
        user[field.key] = manual.toLowerCase();
        return;
      }
      toHash = field.normalize(manual);
    } else if (isSet(field.hashed) && isHex64(trimString(field.hashed).toLowerCase())) {
      user[field.key] = trimString(field.hashed).toLowerCase();
      return;
    } else if (isSet(field.raw)) {
      if (makeString(field.raw).length > MAX_IDENTIFIER_LENGTH) return;
      toHash = field.normalize(field.raw);
    }
    if (!toHash) {
      if (isSet(field.manual) || isSet(field.raw)) log('OpenAI Measurement Pixel: ' + field.key + ' skipped, value rejected by normalization.');
      return;
    }

    pending++;
    sha256(toHash, function (digest) {
      user[field.key] = digest;
      done();
    }, function () {
      log('OpenAI Measurement Pixel: could not hash ' + field.key + ', field skipped.');
      done();
    }, { outputEncoding: 'hex' });
  });

  if (pending === 0 && !finished) {
    finished = true;
    callback(user);
  }
}

function send(event, eventData, user, pixelIds) {
  const oaiq = createArgumentsQueue('oaiq', 'oaiq.q');

  const options = {};
  if (isSet(data.eventId)) options.event_id = trimString(data.eventId);
  if (event.customName) options.custom_event_name = event.customName;
  if (data.optOut) options.opt_out = true;
  const hasOptions = Object.keys(options).length > 0;
  const hasUser = Object.keys(user).length > 0;

  pixelIds.forEach(function (pixelId) {
    const init = { pixelId: pixelId };
    if (data.debug) init.debug = true;
    if (hasUser) init.user = user;
    oaiq('init', init);
    if (hasOptions) {
      oaiq('measureSingle', pixelId, event.name, eventData, options);
    } else {
      oaiq('measureSingle', pixelId, event.name, eventData);
    }
  });

  log('OpenAI Measurement Pixel: ' + event.name + (event.customName ? ' (' + event.customName + ')' : '') + ' sent to ' + pixelIds.join(', '), eventData, hasOptions ? options : '', hasUser ? user : '');

  injectScript(SDK_URL, data.gtmOnSuccess, data.gtmOnFailure, 'oaiq');
}

function main() {
  const pixelIds = parsePixelIds(data.pixelIds);
  if (!pixelIds.length) {
    log('OpenAI Measurement Pixel: no Pixel ID configured.');
    return data.gtmOnFailure();
  }

  const event = resolveEvent();
  if (getType(event) === 'string') {
    log('OpenAI Measurement Pixel: ' + event);
    return data.gtmOnFailure();
  }

  const eventData = buildEventData(STANDARD_EVENTS[event.name]);

  buildUserData(function (user) {
    send(event, eventData, user, pixelIds);
  });
}

main();


