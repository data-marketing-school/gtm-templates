        return { city: 'Seattle', country: 'us', customer_id: '12349878', email: 'test@stape.io', first_name: 'Stape', last_name: 'Stape', phone: '+18012345671', region: 'WA', street: 'Judkins Park', zip: '10000' };
      }
      return key === 'user_id' ? 'root_user' : undefined;
    });
    assertThat(run({ readUserData: true })).isEqualTo({
      country: 'US', city: 'Seattle', region: 'WA', postal_code: '10000',
      email_sha256: 'hash(test@stape.io)', phone_number_sha256: 'hash(18012345671)',
      external_id_sha256: 'hash(12349878)', first_name_sha256: 'hash(stape)', last_name_sha256: 'hash(stape)'
    });
    assertThat(run({ externalId: 'B4C9A289323B21A01C3E940F150EB9B8C542587F1ABFD8F0E1CC1FFC5E475514' }).external_id_sha256).isEqualTo('b4c9a289323b21a01c3e940f150eb9b8c542587f1abfd8f0e1cc1ffc5e475514');
- name: Custom events are validated and missing pixel ID fails the tag
  code: |-
    const calls = [];
    mock('createArgumentsQueue', function () {
      return function (a, b, c, d, e) { calls.push([a, b, c, d, e]); };
    });
    mock('injectScript', function (url, onSuccess) { onSuccess(); });

    runCode({ pixelIds: ' , ', eventNameMethod: 'override', eventType: 'standard', standardEvent: 'page_viewed' });
    assertApi('gtmOnFailure').wasCalled();

    runCode({ pixelIds: 'pixel_a', eventNameMethod: 'override', eventType: 'custom', customEventName: 'order_created' });
    assertApi('gtmOnFailure').wasCalled();

    runCode({ pixelIds: 'pixel_a', eventNameMethod: 'override', eventType: 'custom', customEventName: '_bad.name' });
    assertApi('gtmOnFailure').wasCalled();

    calls.length = 0;
    runCode({ pixelIds: 'pixel_a', eventNameMethod: 'override', eventType: 'custom', customEventName: 'quote_requested' });
    assertApi('gtmOnSuccess').wasCalled();
    assertThat(calls[1][2]).isEqualTo('custom');
    assertThat(calls[1][4].custom_event_name).isEqualTo('quote_requested');
    assertApi('gtmOnFailure').wasCalled();


